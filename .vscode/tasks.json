{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run MMA robot",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["${workspaceFolder}/run_robot.py"],
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "Check MMA robot",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["${workspaceFolder}/run_robot.py", "--check"],
      "problemMatcher": []
    }
  ]
}
